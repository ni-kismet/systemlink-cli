{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slcli skill eval manifest",
  "type": "object",
  "required": ["manifest_version", "skill_name", "recommended_suites", "evals"],
  "properties": {
    "manifest_version": {"const": 1},
    "skill_name": {"type": "string", "minLength": 1},
    "recommended_suites": {
      "type": "object",
      "required": ["gating", "regression"],
      "properties": {
        "gating": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "regression": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_output", "files", "expectations", "grading_rules"],
        "properties": {
          "id": {"type": "integer"},
          "prompt": {"type": "string", "minLength": 1},
          "expected_output": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string"}},
          "expectations": {"type": "array", "items": {"type": "string"}},
          "grading_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "critical", "mode", "patterns"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "critical": {"type": "boolean"},
                "positive_control": {"type": "string", "minLength": 1},
                "negative_control": {"type": "string", "minLength": 1},
                "scope": {"enum": ["response", "command"]},
                "mode": {"enum": ["all_of", "any_of", "none_of"]},
                "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}