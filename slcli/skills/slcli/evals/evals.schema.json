{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slcli skill eval manifest",
  "type": "object",
  "required": ["manifest_version", "skill_name", "recommended_suites", "evals"],
  "properties": {
    "manifest_version": {"const": 1},
    "skill_name": {"type": "string", "minLength": 1},
    "recommended_suites": {
      "type": "object",
      "required": ["gating", "regression"],
      "properties": {
        "gating": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "regression": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "live_readonly": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "online": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_output", "files", "expectations", "grading_rules"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer"},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "prompt": {"type": "string", "minLength": 1},
          "expected_output": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string"}},
          "expectations": {"type": "array", "items": {"type": "string"}},
          "execution_mode": {"enum": ["offline", "online", "live_readonly", "hybrid"]},
          "fixture": {
            "type": "object",
            "required": ["example", "profile", "workspace"],
            "additionalProperties": false,
            "properties": {
              "example": {"type": "string", "minLength": 1},
              "profile": {"type": "string", "minLength": 1},
              "workspace": {"type": "string", "minLength": 1},
              "workspace_id": {"type": "string", "minLength": 1},
              "snapshot_path": {"type": "string", "minLength": 1}
            }
          },
          "mutation_policy": {
            "enum": ["forbidden", "isolated_only", "allow_with_cleanup"]
          },
          "fixture_scope": {
            "enum": ["local", "shared_readonly", "isolated"]
          },
          "cleanup": {
            "type": "object",
            "required": ["required", "strategy"],
            "additionalProperties": false,
            "properties": {
              "required": {"type": "boolean"},
              "strategy": {"enum": ["ownership_marker", "workspace"]}
            }
          },
          "resource_prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "match"],
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "match": {"type": "object", "minProperties": 1},
                "required": {"type": "boolean"}
              }
            }
          },
          "grading_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "critical"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "critical": {"type": "boolean"},
                "positive_control": {"type": "string", "minLength": 1},
                "negative_control": {"type": "string", "minLength": 1},
                "scope": {"enum": ["response", "command"]},
                "validator": {"enum": ["previous_calendar_month"]},
                "control_reference_date": {"type": "string", "format": "date"},
                "grader_type": {
                  "enum": [
                    "regex",
                    "resource_query",
                    "resource_set",
                    "relationship",
                    "negative_query",
                    "snapshot",
                    "mutation_safety",
                    "cleanup"
                  ]
                },
                "grader_config": {"type": "object"},
                "mode": {"enum": ["all_of", "any_of", "none_of"]},
                "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "required_in_modes": {
                  "type": "array",
                  "items": {"enum": ["offline", "online", "live_readonly", "hybrid"]},
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false,
              "oneOf": [
                {
                  "anyOf": [
                    {"not": {"required": ["grader_type"]}},
                    {"properties": {"grader_type": {"const": "regex"}}}
                  ],
                  "required": ["mode", "patterns"]
                },
                {
                  "properties": {
                    "grader_type": {
                      "enum": [
                        "resource_query",
                        "resource_set",
                        "relationship",
                        "negative_query",
                        "snapshot",
                        "mutation_safety",
                        "cleanup"
                      ]
                    }
                  },
                  "required": ["grader_type", "grader_config"]
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["execution_mode"],
              "properties": {
                "execution_mode": {"enum": ["online", "live_readonly", "hybrid"]}
              }
            },
            "then": {"required": ["fixture"]}
          }
        ]
      }
    }
  }
}